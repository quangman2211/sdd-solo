#!/usr/bin/env bash
# sdd-solo commit-msg hook: chặn commit code không có ID, hoặc code trước khi qua cổng.
MSG="$(head -1 "$1")"
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

# Đường dẫn code/test đọc từ .sdd/config. Hook chạy bash trần, không có lib.sh
# nên parse tay. Trước 1.5.0 hai đường dẫn này viết chết là src|tests — repo
# nào đặt code ở app/ là hook cho qua hết mà không nói một lời.
cfg() { sed -n "s/^$1=//p" "$ROOT/.sdd/config" 2>/dev/null | tail -1 | sed 's/[[:space:]]*$//'; }
CP="$(cfg code_paths)"; [ -z "$CP" ] && CP="src"
TP="$(cfg test_paths)"; [ -z "$TP" ] && TP="tests"
RE="^($(printf '%s %s' "$CP" "$TP" | tr -s ' ' '|' | sed 's/^|//; s/|$//'))/"

# Config sai thì hook mù. Phân biệt "repo chưa có code" với "config sai" bằng
# chính danh sách file đang commit: có file nguồn mà không khớp đường dẫn nào
# → chặn, đừng cho qua trong im lặng.
# Danh sách LOẠI TRỪ chứ không phải danh sách cho phép: sai sót nghiêng về
# chặn nhầm, đỡ hơn nghiêng về bỏ lọt. File không có phần mở rộng (Makefile,
# Dockerfile…) không tính, để repo chưa có code không bị chặn oan.
SRCLIKE="$(echo "$STAGED" | grep -vE '^(specs|docs|changes|checklists|prompts|\.sdd|\.githooks)/' \
          | grep -E '\.[A-Za-z0-9]+$' \
          | grep -viE '\.(md|markdown|txt|json|jsonc|lock|ya?ml|toml|ini|cfg|conf|env|csv|tsv|svg|png|jpe?g|gif|ico|webp|pdf|bpmn|dmn|drawio|mmd|html?|css|scss|less|gitignore|editorconfig|npmrc|nvmrc|bak|new)$')"
OUTSIDE="$(echo "$SRCLIKE" | grep -vE "$RE")"
HAVE=0; for d in $CP $TP; do [ -d "$ROOT/$d" ] && HAVE=1; done
if [ -n "$SRCLIKE" ] && [ "$HAVE" = 0 ]; then
  echo "✗ sdd-solo: commit có file nguồn nhưng không thư mục nào trong '$CP $TP' tồn tại." >&2
  echo "  .sdd/config đang sai bố cục repo → hook không kiểm được gì. Sửa code_paths/test_paths:" >&2
  echo "$SRCLIKE" | sed 's/^/    /' >&2
  exit 1
elif [ -n "$OUTSIDE" ]; then
  echo "! sdd-solo: file nguồn nằm ngoài '$CP $TP' nên không được kiểm:" >&2
  echo "$OUTSIDE" | sed 's/^/    /' >&2
  echo "  Thêm vào code_paths trong .sdd/config nếu đó là code thật." >&2
fi

TOUCH_CODE=0; echo "$STAGED" | grep -vE 'README\.md$' | grep -qE "$RE" && TOUCH_CODE=1
echo "$MSG" | grep -qE '^Merge|^Revert|^chore\(sdd\)' && exit 0
if [ "$TOUCH_CODE" = 1 ]; then
  ID="$(echo "$MSG" | grep -oE '\((UC|BR|RULE|ADR|CHG)-[0-9]+\)' | head -1 | tr -d '()')"
  if [ -z "$ID" ]; then
    echo "✗ Commit đụng $CP hoặc $TP phải có ID: <type>(UC-###): ..." >&2; exit 1
  fi
  case "$ID" in UC-*)
    if [ ! -f "$ROOT/.sdd/gate/$ID.ok" ]; then
      echo "✗ $ID chưa qua cổng DoR (.sdd/gate/$ID.ok không có). Spec trước, code sau — chạy /sdd-solo:gate $ID." >&2; exit 1
    fi
    if ! git log --format=%s | grep -qE "^docs\($ID\)"; then
      echo "✗ Chưa có commit docs($ID) nào trước commit code này." >&2; exit 1
    fi;;
  esac
fi
exit 0
