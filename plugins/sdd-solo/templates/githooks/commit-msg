#!/usr/bin/env bash
# sdd-solo commit-msg hook: blocks a code commit with no ID, or code committed before the gate.
MSG="$(head -1 "$1")"
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

# The code/test paths are read from .sdd/config. The hook runs bare bash with no lib.sh, so it parses
# them by hand. Before 1.5.0 these two paths were hard-coded as src|tests — a repo with its code in
# app/ had every commit waved through without a word.
cfg() { sed -n "s/^$1=//p" "$ROOT/.sdd/config" 2>/dev/null | tail -1 | sed 's/[[:space:]]*$//'; }
CP="$(cfg code_paths)"; [ -z "$CP" ] && CP="src"
TP="$(cfg test_paths)"; [ -z "$TP" ] && TP="tests"
UCT="$(cfg uc_test_dir)"; [ -z "$UCT" ] && UCT="tests/use-cases"
RE="^($(printf '%s %s' "$CP" "$TP" | tr -s ' ' '|' | sed 's/^|//; s/|$//'))/"
TLP="$(cfg tool_paths)"
# tool_paths: real code belonging to no UC (a measuring script, a conversion script). Empty makes
# everything below a no-op, so a repo that has not declared it behaves exactly as before (#31).
TRE=""; [ -n "$TLP" ] && TRE="^($(printf '%s' "$TLP" | tr -s ' ' '|' | sed 's/^|//; s/|$//'))/"
notool() { if [ -n "$TRE" ]; then grep -vE "$TRE"; else cat; fi; }


# A wrong config makes the hook blind. "The repo has no code" is told apart from "the config is wrong"
# by the list of files being committed: a source file matching no path
# → block, do not wave it through in silence.
# An EXCLUDE list rather than an allow list: a mistake leans towards blocking wrongly, which is better
# than leaning towards letting things through. A file with no extension (Makefile, Dockerfile…) does
# not count, so a repo without code is not blocked for nothing.
# --diff-filter=d ONLY here: a file being deleted has nothing to check for "outside code_paths" — warning
# about the 6 .specify/*.sh files being git rm-ed (runxops, 5.1.0) is noise that teaches people to ignore this.
# It is NOT filtered on the global $STAGED: the TOUCH_CODE line below and pre-commit also read $STAGED, and a
# commit DELETING domain code tagged with a UC that has not passed the gate is still a commit touching code —
# it must be blocked exactly like a commit adding it.
SRCLIKE="$(git diff --cached --name-only --diff-filter=d | grep -vE '^(specs|docs|changes|checklists|prompts|\.sdd|\.githooks)/' \
          | grep -vE '(^|/)\.[A-Za-z0-9_-]+$' \
          | grep -E '\.[A-Za-z0-9]+$' \
          | grep -viE '\.(md|markdown|txt|json|jsonc|lock|ya?ml|toml|ini|cfg|conf|env|csv|tsv|svg|png|jpe?g|gif|ico|webp|pdf|bpmn|dmn|drawio|mmd|html?|css|scss|less|gitignore|editorconfig|npmrc|nvmrc|bak|new)$')"
OUTSIDE="$(echo "$SRCLIKE" | grep -vE "$RE" | notool)"
HAVE=0; for d in $CP $TP; do [ -d "$ROOT/$d" ] && HAVE=1; done
if [ -n "$SRCLIKE" ] && [ "$HAVE" = 0 ]; then
  echo "✗ sdd-solo: the commit has source files but no directory in '$CP $TP' exists." >&2
  echo "  .sdd/config does not match the repo layout → the hook cannot check anything. Fix code_paths/test_paths:" >&2
  echo "$SRCLIKE" | sed 's/^/    /' >&2
  exit 1
elif [ -n "$OUTSIDE" ]; then
  echo "! sdd-solo: source files outside '$CP $TP', so they are not checked:" >&2
  echo "$OUTSIDE" | sed 's/^/    /' >&2
  echo "  Add them to code_paths in .sdd/config if that is real code." >&2
fi

# Exemption by FILE, not by the wording of the commit: classifying by commit prefix means a mistyped
# prefix gets through, whereas a file does not move by itself.
TOUCH_CODE=0; echo "$STAGED" | grep -vE 'README\.md$' | notool | grep -qE "$RE" && TOUCH_CODE=1
# 7.2: Merge/Revert/chore(sdd) are EXEMPT from the ID check but NOT from the repo own rules in commit-msg.d/ (the
# role boundary must see the arbiter chore commits too). Up to 7.1 this line did `exit 0` before the .d loop → every
# .d piece was blind to those three kinds of commit.
SKIP_ID=0; echo "$MSG" | grep -qE '^Merge|^Revert|^chore\(sdd\)' && SKIP_ID=1
if [ "$TOUCH_CODE" = 1 ] && [ "$SKIP_ID" = 0 ]; then
  ID="$(echo "$MSG" | grep -oE '\((UC|BR|RULE|ADR|CHG)-[0-9]+\)' | head -1 | tr -d '()')"
  if [ -z "$ID" ]; then
    echo "✗ A commit touching $CP or $TP must carry an ID: <type>(UC-###): ..." >&2; exit 1
  fi
  # EVERY prefix must prove its ID is real. Before 2.1.2 only UC-* was checked, so relabelling to
  # feat(CHG-999) got everything through — including a completely invented ID. That was a skip flag
  # three characters long, while the README promised there were none. See #15.
  case "$ID" in
  UC-*)
    if [ ! -f "$ROOT/.sdd/gate/$ID.ok" ]; then
      echo "✗ $ID has not passed the DoR gate (.sdd/gate/$ID.ok is missing). Spec first, code after — run /sdd-solo:gate $ID." >&2; exit 1
    fi
    if ! git log --format=%s | grep -qE "^docs\($ID\)"; then
      echo "✗ There is no docs($ID) commit before this code commit." >&2; exit 1
    fi;;
  CHG-*)
    # 2.0.0 moved changes/ → specs/changes/; both are accepted for an unmigrated repo
    # `ls a b` fails if ANY argument is bad — a second glob that does not match would block
    # even a real ID. Each place must be asked separately.
    if ! ls -d "$ROOT/specs/changes/$ID-"* >/dev/null 2>&1 && \
       ! ls -d "$ROOT/changes/$ID-"* >/dev/null 2>&1; then
      echo "✗ $ID has no specs/changes/$ID-*/ directory — an invented ID, or the change was never created." >&2; exit 1
    fi
    # 3.0.0: the directory existing is not enough. Before that, Phase 5 had no gate at all, so a change
    # touching behaviour ALREADY delivered to a customer could enter the repo with an empty proposal, an
    # empty delta, and no statement of which AC it overturned. See #16.
    if [ ! -f "$ROOT/.sdd/gate/$ID.ok" ]; then
      echo "✗ $ID has not passed the Phase 5 gate (.sdd/gate/$ID.ok is missing) — run /sdd-solo:change $ID." >&2; exit 1
    fi;;
  # 7.0: two layouts — 6.x specs/rules.md · specs/br.md · specs/internal/adr; 7.0 adds
  # specs/<craft>/rules.md · specs/*/br-###/br.md · specs/adr · specs/<craft>/adr. The same list as
  # id_exists in lib.sh; the hook runs bare bash so it is copied, and changing one means changing both.
  RULE-*)
    if ! cat "$ROOT"/specs/rules.md "$ROOT"/specs/*/rules.md 2>/dev/null | grep -qE "^## $ID\b"; then
      echo "✗ $ID has no heading in specs/rules.md (or specs/<craft>/rules.md)." >&2; exit 1
    fi;;
  BR-*)
    if ! cat "$ROOT"/specs/br.md "$ROOT"/specs/*/br-[0-9]*/br.md 2>/dev/null | grep -qE "^#{1,2} $ID\b"; then
      echo "✗ $ID has no heading in specs/br.md (or specs/*/br-###/br.md)." >&2; exit 1
    fi;;
  ADR-*)
    # `ls a b` fails if ANY glob is bad (trap #16) — ask each directory separately.
    ADR_OK=0
    for d in "$ROOT/specs/adr" "$ROOT"/specs/*/adr "$ROOT/specs/internal/adr" "$ROOT/docs/adr"; do
      ls "$d/$ID"* >/dev/null 2>&1 && { ADR_OK=1; break; }
    done
    if [ "$ADR_OK" = 0 ]; then
      echo "✗ $ID has no ADR file (specs/adr/ · specs/<craft>/adr/ · specs/internal/adr/)." >&2; exit 1
    fi;;
  esac
fi
# .d/ — the repo own rules (#50): every executable file in commit-msg.d runs below, in name order.
# The plugin does not touch the repo files there on update. The hooks live in git → each worktree runs
# its own branch copy; a new rule takes effect on another branch after a merge (see commit-msg.d/README.md).
export SDD_ROOT="$ROOT" SDD_STAGED="$STAGED" SDD_CODE_PATHS="$CP" SDD_TEST_PATHS="$TP" SDD_UC_TEST_DIR="$UCT" SDD_MSG="$MSG"
for h in "$ROOT/.sdd/hooks/commit-msg.d/"*; do
  [ -f "$h" ] && [ -x "$h" ] || continue
  case "$h" in *.example|*README*) continue;; esac
  "$h" "$1" || { rc=$?; echo "✗ commit-msg.d/$(basename "$h") blocked the commit (exit $rc)" >&2; exit 1; }
done
exit 0
