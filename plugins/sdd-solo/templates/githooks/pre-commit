#!/usr/bin/env bash
# sdd-solo pre-commit hook: do not mix spec and code in one commit.
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

cfg() { sed -n "s/^$1=//p" "$ROOT/.sdd/config" 2>/dev/null | tail -1 | sed 's/[[:space:]]*$//'; }
CP="$(cfg code_paths)"; [ -z "$CP" ] && CP="src"
TP="$(cfg test_paths)"; [ -z "$TP" ] && TP="tests"
UCT="$(cfg uc_test_dir)"; [ -z "$UCT" ] && UCT="tests/use-cases"
RE="^($(printf '%s %s' "$CP" "$TP" | tr -s ' ' '|' | sed 's/^|//; s/|$//'))/"
TLP="$(cfg tool_paths)"
# tool_paths: real code belonging to no UC (a measuring script, a conversion script). Empty makes
# everything below a no-op, so a repo that has not declared it behaves exactly as before (#31).
TRE=""; [ -n "$TLP" ] && TRE="^($(printf '%s' "$TLP" | tr -s ' ' '|' | sed 's/^|//; s/|$//'))/"
notool() { if [ -n "$TRE" ]; then grep -vE "$TRE"; else cat; fi; }


SPEC=0; CODE=0
echo "$STAGED" | grep -vE '/_template/' | grep -qE '^specs/.*UC-[0-9]+\.md$|^specs/([^/]+/)?rules\.md$' && SPEC=1
echo "$STAGED" | grep -vE 'README\.md$' | notool | grep -qE "$RE" && CODE=1
# 7.4 (P-42): a MERGE commit (MERGE_HEAD present) carries both the spec and the code of the other branch — the two
# were separate on the source branch, this is not somebody mixing them. Blocking it stops a code/uc-### worktree from
# merging main once main holds a spec commit and a code commit.
MERGING=0; [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ] && MERGING=1
if [ "$SPEC" = 1 ] && [ "$CODE" = 1 ] && [ "$MERGING" = 0 ]; then
  echo "✗ This commit mixes spec (specs/) and code ($CP $TP). Split them: commit docs(UC-###) first, then feat(UC-###)." >&2
  exit 1
fi
# .d/ — the repo own rules (#50): every executable file in pre-commit.d runs below, in name order.
# The plugin does not touch the repo files there on update. The hooks live in git → each worktree runs
# its own branch copy; a new rule takes effect on another branch after a merge (see pre-commit.d/README.md).
export SDD_ROOT="$ROOT" SDD_STAGED="$STAGED" SDD_CODE_PATHS="$CP" SDD_TEST_PATHS="$TP" SDD_UC_TEST_DIR="$UCT"
for h in "$ROOT/.sdd/hooks/pre-commit.d/"*; do
  [ -f "$h" ] && [ -x "$h" ] || continue
  case "$h" in *.example|*README*) continue;; esac
  "$h" || { rc=$?; echo "✗ pre-commit.d/$(basename "$h") blocked the commit (exit $rc)" >&2; exit 1; }
done
exit 0
